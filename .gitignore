# gstack is vendored per-developer (see CLAUDE.md): clone it yourself into
# .claude/skills/gstack and run ./setup — the setup generates the sibling
# skill symlink dirs. Neither belongs in version control (nested git repo +
# absolute-path symlinks).
.claude/skills/
.omc/
.DS_Store
.gstack/
# Local SOP blob storage (F1) — uploaded SOP bytes live here in dev; never commit them.
_sop_storage/
backend/_sop_storage/
storage/materials/
backend/storage/
# Client-supplied source material (training bank + real SOP/WI/JD docs). PUBLIC repo — real client
# content (role names, document numbers, SOP sections, KPI thresholds) must NEVER be committed.
# Ingested into the (gitignored) DB at deploy time via the local-only importer script below.
EU_avatar_inspector_interview/
# The interview-bank importer + its test carry client-specific strings (bank/role names, conflict
# figures, real source filenames), so they stay local-only deploy artifacts — never committed to
# the PUBLIC repo. Run the importer at deploy time from a local checkout; it writes only to the DB.
backend/scripts/import_rfcsm_bank.py
backend/tests/test_import_rfcsm_bank.py
# Local dev SQLite DB — never commit.
*.db
backend/*.db
# Env files carry live Azure endpoints/keys — never commit (PUBLIC repo). Only .env.example is
# tracked. Defense-in-depth alongside backend/.gitignore.
.env
.env.*
!.env.example
# Playwright E2E artifacts
frontend/playwright-report/
frontend/test-results/
frontend/.playwright/
backend/e2e.db

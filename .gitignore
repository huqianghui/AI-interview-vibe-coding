# gstack is vendored per-developer (see CLAUDE.md): clone it yourself into
# .claude/skills/gstack and run ./setup — the setup generates the sibling
# skill symlink dirs. Neither belongs in version control (nested git repo +
# absolute-path symlinks).
.claude/skills/
.omc/
.DS_Store
.gstack/
# Local SOP blob storage (F1) — uploaded SOP bytes live here in dev; never commit them.
_sop_storage/
backend/_sop_storage/
storage/materials/
backend/storage/
# Local dev SQLite DB — never commit.
*.db
backend/*.db

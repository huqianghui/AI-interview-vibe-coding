# AI Interview — backend environment template.
#
# Copy to `backend/.env` and fill in real values for a live Azure run. `backend/.env` is
# gitignored (see backend/.gitignore) — NEVER commit real endpoints/keys to this PUBLIC repo.
#
# You do NOT need any of this to build, test, or demo on mocks: with the provider defaults below
# left as `mock`, the whole candidate + admin flow (and the E2E suite) runs with zero Azure.
# Only set the Azure_* values when you want a real Foundry / Voice Live / Search run.

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="AI Interview"
DEBUG=false
# Local dev/CI uses SQLite. Point at Postgres etc. for a deployed instance.
DATABASE_URL=sqlite+aiosqlite:///./ai_interview.db

# ── Auth ─────────────────────────────────────────────────────────────────────
# CHANGE for any non-local run. Admin routes are gated by a real admin login (JWT, role=admin);
# set SEED_ADMIN_PASSWORD to have boot seed the `admin` account.
# REQUIRED (no code default): signs JWTs and derives the seeded candidate passwords.
# Generate: openssl rand -hex 32
SECRET_KEY=
SEED_ADMIN_PASSWORD=

# ── Provider selection ─────────────────────────────────────────────────────────
# `mock` keeps everything Azure-free. Flip to the real providers for a live run:
#   DEFAULT_LLM_PROVIDER=azure_openai
#   DEFAULT_RETRIEVAL_PROVIDER=azure         (Foundry IQ / Azure AI Search SOP retrieval)
#   DEFAULT_AGENT_SYNC_PROVIDER=azure        (sync interviewer personas to Foundry agents)
DEFAULT_LLM_PROVIDER=mock
DEFAULT_RETRIEVAL_PROVIDER=mock
DEFAULT_AGENT_SYNC_PROVIDER=mock

# ── Model deployments (IMPORTANT) ────────────────────────────────────────────────
# Project default is gpt-5-mini for both; second choice gpt-4.1-mini. FOUNDRY_AGENT_MODEL must be
# a chat deployment that exists on your Foundry resource. VOICE_LIVE_DEFAULT_MODEL must be a model
# Voice Live hosts natively in your region (Learn: Speech regions → Voice Live tab) — your own
# deployments do NOT count. Live-verified on Sweden Central (2026-09-23): OK = gpt-5-mini,
# gpt-4.1-mini, gpt-5.6-terra, gpt-5.4, gpt-5.1, gpt-4o(-mini), gpt-realtime-*; REJECTED =
# gpt-5.6-luna, gpt-5.6-sol, gpt-5.4-mini, gpt-6-* ("Model X is not supported in this region").
FOUNDRY_AGENT_MODEL=gpt-5-mini
VOICE_LIVE_DEFAULT_MODEL=gpt-5-mini

# ── Azure OpenAI (LLM: drafting checklists, judging answers) ─────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Foundry IQ / Azure AI Search (F1 SOP retrieval + citations) ──────────────────
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=            # knowledge base name (URL path segment)
AZURE_SEARCH_KNOWLEDGE_SOURCE= # KS name in the retrieve body (≠ index)
AZURE_SEARCH_API_KEY=
# RemoteTool project-connection that authenticates the agent's MCP call to the KB (P15). NOT a
# CognitiveSearch/ApiKey connection (those 403). Leave empty to let the adapter resolve/create it.
FOUNDRY_KB_MCP_CONNECTION=

# ── Foundry project (F5 interviewer-agent sync) ──────────────────────────────────
# Project-scoped endpoint …/api/projects/{project} — the bare account endpoint 404s on agent calls.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_API_KEY=

# ── Azure Voice Live (F9) ────────────────────────────────────────────────────────
# The backend's /voice-live/ws proxy holds the Voice Live connection; the browser never talks to
# Azure directly.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEFAULT_PROJECT=
# SOP search embeddings (hybrid search: keywords + vectors). A deployment on AZURE_FOUNDRY_ENDPOINT;
# set it empty to search by keywords only.
SOP_EMBEDDING_DEPLOYMENT=text-embedding-3-small
SOP_EMBEDDING_API_VERSION=2024-10-21
# Voice Live realtime api-version. Classic Foundry agents (agent-sync's current output) require
# 2026-01-01-preview or 2025-10-01; 2026-04-10+ reject them ("Classic foundry agent is not
# supported"). Live-verified against a real Foundry project. Only raise this once agents are
# migrated to the new (non-classic) Foundry agent type.
VOICE_LIVE_API_VERSION=2026-01-01-preview

# Mic uplink sample rate (Hz) declared as the session's input_audio_sampling_rate. Azure accepts only
# 16000 or 24000 for pcm16 and defaults to 24000; we use 16000 because the cascaded path's recogniser
# is a 16 kHz pipeline anyway, which cuts the uplink by a third. MUST match the frontend's
# MIC_SAMPLE_RATE (frontend/src/hooks/useVoiceAudio.ts) — a mismatch garbles every transcript.
VOICE_LIVE_INPUT_SAMPLING_RATE=16000

# Optional cap on the avatar VIDEO bitrate in bits/s (session.avatar.video.bitrate). Unset = Azure's
# default (2 Mbps at 1080p). This is an escape hatch, not the weak-network mechanism: Azure already
# adapts its own bitrate, and the real fix is dropping the picture to protect the voice (see
# docs/avatar-weaknet-probe.md). Leave unset unless a specific network needs a hard cap.
# VOICE_LIVE_AVATAR_VIDEO_BITRATE=500000

# ── SOP blob storage (F1) ────────────────────────────────────────────────────────
# Raw SOP uploads live here, never in the DB and never handed to candidates directly (P4).
# local = files under MATERIAL_STORAGE_PATH (dev). azure = the MATERIAL_BLOB_CONTAINER of
# AZURE_STORAGE_ACCOUNT_URL via managed identity / az login — what production runs.
DEFAULT_STORAGE_PROVIDER=local
MATERIAL_STORAGE_PATH=./_sop_storage
# AZURE_STORAGE_ACCOUNT_URL=https://<account>.blob.core.windows.net
# MATERIAL_BLOB_CONTAINER=materials
MATERIAL_MAX_SIZE_MB=25

dependencies | where client_Type!="Browser" | where not(name endswith " http send" or name endswith " http receive")
| project timestamp,itemId,id,operation_Id,operation_ParentId,name=tostring(split(name,"?")[0]),type,target=tostring(split(target,"?")[0]),duration,success,resultCode,itemCount,role=cloud_RoleName,instance=cloud_RoleInstance
| order by timestamp asc
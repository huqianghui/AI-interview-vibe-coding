customEvents | where name startswith "voice."
| project timestamp,itemId,name,operation_Id,operation_ParentId,itemCount,interview_id=tostring(customDimensions.interview_id),audio_path=tostring(customDimensions.audio_path),avatar=tostring(customDimensions.avatar),linear_turns=tostring(customDimensions.linear_turns),outcome=tostring(customDimensions.outcome),turn_kind=tostring(customDimensions.kind),heard=tostring(customDimensions.heard),turn_index=coalesce(toint(customDimensions.turn_index),toint(customMeasurements.turn_index)),mode=tostring(customDimensions.mode),label=tostring(customDimensions.label),local_candidate=tostring(customDimensions.local_candidate),remote_candidate=tostring(customDimensions.remote_candidate),protocol=tostring(customDimensions.protocol),relay_protocol=tostring(customDimensions.relay_protocol),resolution=tostring(customDimensions.resolution),partial=tostring(customDimensions.partial),measurements=customMeasurements
| order by timestamp asc